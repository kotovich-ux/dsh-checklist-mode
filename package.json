{
  "name": "dsh-checklist-mode",
  "version": "0.1.0",
  "type": "module",
  "description": "Strict checklist mode for DeepSeek Harness: /checklist adds a numbered-plan policy to the agent's system prompt and can send the task in one step.",
  "license": "MIT",
  "author": "kotovich-ux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotovich-ux/dsh-checklist-mode.git"
  },
  "homepage": "https://github.com/kotovich-ux/dsh-checklist-mode#readme",
  "bugs": {
    "url": "https://github.com/kotovich-ux/dsh-checklist-mode/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "checklist",
    "plan-mode",
    "agent-policy"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  }
}
